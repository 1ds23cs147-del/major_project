# Large local source datasets are not versioned with the application code.
original datasets/
datasets/
project_data/datasets/
project_data/original_datasets/
project_data/artifacts/
project_data/runs/
project_data/weights/

# Uploaded scene captures are runtime data, not source code.
webapp/uploads/
webapp/snapshots/

# FireWatch runtime state and captured evidence are local data.
firewatch/firewatch.db
firewatch/static/snapshots/
firewatch-private-backup*.db
firewatch-private-backup*.db-wal
firewatch-private-backup*.db-shm
droidcam_current.jpg

# Curated inference/training weights are intentionally tracked with Git LFS.
!models/
!models/*.pt

